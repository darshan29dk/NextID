# Copy this file to .env and fill in real values. .env itself is
# gitignored on purpose (it used to be committed with real secrets, which
# is exactly what this template exists to prevent from happening again).

# MySQL connection string for the shared database. Ask a team lead for the
# real host/username/password rather than guessing - do not reuse any
# value that was ever visible in git history.
DATABASE_URL=mysql+pymysql://<username>:<password>@<host>:3306/<database_name>

# Set to true only if the DB requires an SSL connection.
DB_SSL=false
DB_SSL_CIPHER=

# Required. Used to encrypt/decrypt Data Source connector passwords stored
# in the database - the app will refuse to start without this set. Generate
# your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do NOT reuse a key that was ever committed to git or shared outside this
# team - anyone with an old key can decrypt any connector password that was
# encrypted with it.
ENCRYPTION_KEY=

# SMTP settings used to send OTP/password-reset emails. These can also be
# configured from the in-app Settings > SMTP Settings page instead - if set
# there, that takes priority over these env values. Use a dedicated mailbox
# for this, not a personal account's app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
