# Copy this file to .env (local dev) or .env.production (server build) and
# set the value for your environment. If not set, the app falls back to
# http://localhost:8000/api, which is correct for local development only.

# Local dev (backend running on your own machine):
# VITE_API_BASE_URL=http://localhost:8000/api

# Deployed on the Azure VM (backend running on the same server):
# VITE_API_BASE_URL=http://4.240.74.5:8000/api

VITE_API_BASE_URL=
